{
  "entities": {
    "Activity": {
      "title": "Activity",
      "description": "Một hoạt động ngắn hỗ trợ học sinh THCS tái tập trung và quay lại nhiệm vụ học tập.",
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "minLength": 3,
          "maxLength": 140,
          "description": "Tên hoạt động ngắn gọn, rõ ràng"
        },
        "slug": {
          "type": "string",
          "minLength": 3,
          "maxLength": 160,
          "pattern": "^[a-z0-9\\-]+$",
          "description": "Định danh URL thân thiện"
        },
        "group": {
          "type": "string",
          "enum": ["van-dong", "quan-sat", "ghi-nho", "phan-xa", "tuong-tac", "thu-gian"],
          "description": "Nhóm hoạt động thuộc 1 trong 6 nhóm chính"
        },
        "expressions": {
          "type": "array",
          "description": "Danh sách mã biểu hiện phù hợp (từ 1 đến 6 biểu hiện)"
        },
        "durationMinutes": {
          "type": "number",
          "description": "Thời lượng tổ chức hoạt động tính bằng phút (1-15)"
        },
        "scale": {
          "type": "string",
          "enum": ["Cả lớp", "Theo nhóm", "Theo cặp", "Cá nhân tại chỗ"],
          "description": "Quy mô tổ chức trong lớp học"
        },
        "materials": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "description": "Dụng cụ cần thiết (hoặc Không cần học cụ)"
        },
        "noMaterialsNeeded": {
          "type": "boolean",
          "description": "Đánh dấu không cần chuẩn bị dụng cụ"
        },
        "shortDescription": {
          "type": "string",
          "minLength": 10,
          "maxLength": 320,
          "description": "Mô tả tóm tắt mục đích và cách chơi"
        },
        "goal": {
          "type": "string",
          "minLength": 5,
          "maxLength": 400,
          "description": "Mục tiêu sư phạm của hoạt động"
        },
        "steps": {
          "type": "array",
          "description": "Các bước hướng dẫn giáo viên tổ chức thực hiện"
        },
        "transitionBackTip": {
          "type": "string",
          "minLength": 5,
          "maxLength": 300,
          "description": "Gợi ý câu dẫn giúp học sinh quay lại nhiệm vụ học tập chính"
        },
        "teacherNotes": {
          "type": "string",
          "maxLength": 500,
          "description": "Lưu ý dành cho giáo viên THCS khi điều phối"
        },
        "suitableTiming": {
          "type": "string",
          "enum": ["Đầu tiết", "Giữa tiết", "Chuyển tiếp nhiệm vụ", "Cuối tiết", "Linh hoạt"],
          "description": "Thời điểm phù hợp trong tiết học"
        },
        "gradeRange": {
          "type": "string",
          "minLength": 2,
          "maxLength": 60,
          "description": "Khối lớp phù hợp (ví dụ: Lớp 6 – Lớp 9)"
        },
        "status": {
          "type": "string",
          "enum": ["published", "hidden"],
          "description": "Trạng thái hiển thị: chỉ published mới xuất hiện công khai"
        },
        "authorId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "description": "UID giáo viên tạo hoạt động"
        },
        "authorName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100,
          "description": "Tên hiển thị của giáo viên tạo"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Thời điểm tạo trên máy chủ"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Thời điểm cập nhật gần nhất trên máy chủ"
        }
      },
      "required": [
        "title",
        "slug",
        "group",
        "expressions",
        "durationMinutes",
        "scale",
        "materials",
        "noMaterialsNeeded",
        "shortDescription",
        "goal",
        "steps",
        "transitionBackTip",
        "teacherNotes",
        "suitableTiming",
        "gradeRange",
        "status",
        "authorId",
        "authorName",
        "createdAt",
        "updatedAt"
      ]
    },
    "Teacher": {
      "title": "Teacher",
      "description": "Giáo viên được cấp quyền quản trị nội dung thư viện hoạt động.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "displayName": {
          "type": "string",
          "minLength": 2,
          "maxLength": 100
        },
        "role": {
          "type": "string",
          "enum": ["teacher", "admin"]
        },
        "addedBy": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["uid", "displayName", "role", "addedBy", "createdAt", "updatedAt"]
    },
    "TeacherRequest": {
      "title": "TeacherRequest",
      "description": "Yêu cầu cấp quyền biên tập thư viện từ tài khoản giáo viên.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "displayName": {
          "type": "string",
          "minLength": 2,
          "maxLength": 100
        },
        "schoolName": {
          "type": "string",
          "minLength": 2,
          "maxLength": 140
        },
        "note": {
          "type": "string",
          "maxLength": 300
        },
        "status": {
          "type": "string",
          "enum": ["pending", "approved", "rejected"]
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["uid", "displayName", "schoolName", "note", "status", "createdAt", "updatedAt"]
    },
    "LibraryMeta": {
      "title": "LibraryMeta",
      "description": "Trạng thái khởi tạo dữ liệu mẫu của thư viện.",
      "type": "object",
      "properties": {
        "seeded": {
          "type": "boolean"
        },
        "totalSeededCount": {
          "type": "number"
        },
        "updatedBy": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["seeded", "totalSeededCount", "updatedBy", "updatedAt"]
    }
  },
  "firestore": {
    "/activities/{activityId}": {
      "schema": { "$ref": "#/entities/Activity" },
      "description": "Kho lưu trữ các hoạt động hỗ trợ tái tập trung trong lớp học THCS"
    },
    "/teachers/{teacherId}": {
      "schema": { "$ref": "#/entities/Teacher" },
      "description": "Danh sách UID giáo viên được cấp quyền thêm, sửa, ẩn, xóa hoạt động"
    },
    "/teacher_requests/{requestId}": {
      "schema": { "$ref": "#/entities/TeacherRequest" },
      "description": "Yêu cầu xin cấp quyền quản trị thư viện từ giáo viên"
    },
    "/library_meta/{metaId}": {
      "schema": { "$ref": "#/entities/LibraryMeta" },
      "description": "Cấu hình trạng thái đồng bộ dữ liệu mẫu của thư viện"
    }
  }
}
